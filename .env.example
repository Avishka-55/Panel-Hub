# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/panelhub

# JWT Secret & Expiration
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# AES-256-GCM Master Key (32 bytes / 64 hex characters)
# Generate with: openssl rand -hex 32
# NEVER hardcode or commit this key to version control!
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Configuration ('*' or comma-separated origins)
CORS_ORIGIN=*

# Development Mock 3x-ui Panel (Set to 'true' to start a built-in mock 3x-ui panel on MOCK_PANEL_PORT)
START_MOCK_PANEL=true
MOCK_PANEL_PORT=2053

# Cloudflare Turnstile CAPTCHA Protection (Free from dash.cloudflare.com)
# Public site key used by the frontend widget
CLOUDFLARE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here
# Secret key used for server-side token validation
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

