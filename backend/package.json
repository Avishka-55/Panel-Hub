{
  "name": "panelhub-backend",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS Admin Platform for 3x-ui VPN Panels",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:start": "docker start mongodb 2>/dev/null || docker run -d --name mongodb -p 27017:27017 --restart unless-stopped -v mongodb_data:/data/db mongo:latest",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "3x-ui",
    "vpn",
    "multi-tenant",
    "admin",
    "xray"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^5.0.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.11",
    "tough-cookie": "^5.1.1",
    "uuid": "^11.0.4",
    "zod": "^4.6.5"
  }
}
